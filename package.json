{
  "name": "ghcp-workshop-agentic-development",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm run db:init && npm run app:start",
    "app:start": "node --disable-warning=ExperimentalWarning app/index.mjs",
    "db:init": "node --disable-warning=ExperimentalWarning scripts/init-db.mjs",
    "db:query": "node --disable-warning=ExperimentalWarning scripts/query-db.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "verify": "npm run db:init && npm test"
  }
}